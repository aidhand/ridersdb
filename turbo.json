{
  "$schema": "https://turborepo.com/schema.json",

  "ui": "tui",

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "src/**", "tsconfig.json"],
      "outputs": [".nuxt/**", "!.nuxt/cache/**", "dist/**", ".tsbuildinfo"]
    },

    "start": {
      "dependsOn": ["build"],
      "persistent": true,
      "env": ["NUXT_DATABASE_URL"]
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["NUXT_DATABASE_URL"]
    },

    "clean": {},

    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "**/*.{js,ts,vue,json}",
        "eslint.config.*",
        "tsconfig.json"
      ]
    },

    "format": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "**/*.{js,ts,vue,json,md}",
        ".prettierrc*",
        "prettier.config.*"
      ]
    },

    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "**/*.{ts,vue}",
        "tsconfig.json",
        "**/*.d.ts"
      ]
    },

    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "tests/**",
        "**/*.test.*",
        "**/*.spec.*",
        "vitest.config.*",
        "tsconfig.json"
      ],
      "outputs": ["coverage/**"]
    }
  }
}
