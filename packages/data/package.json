{
  "$schema": "https://json.schemastore.org/package",
  "name": "@repo/data",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "clean": "rimraf -g {dist,coverage,coverage.json,.*cache,*.tsbuildinfo,**.log,**.map}",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "@repo/shared": "workspace:*",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.2",
    "zod": "^3.25.49"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^24.0.10",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.27.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
