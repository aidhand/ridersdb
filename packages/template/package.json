{
  "$schema": "https://json.schemastore.org/package",
  "name": "@repo/template",
  "version": "1.0.0",
  "type": "module",
  "description": "Template package for RidersDB workspace",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "clean": "rimraf -g {dist,coverage,coverage.json,.*cache,*.tsbuildinfo,**.log,**.map}",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@repo/shared": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^9.27.0",
    "typescript": "^5.8.3",
    "@repo/config": "workspace:*",
    "@types/node": "^24.0.7",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "prettier": "^3.5.3",
    "vitest": "^3.2.4",
    "@types/bun": "^1.2.17",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
