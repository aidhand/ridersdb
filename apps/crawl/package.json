{
  "$schema": "https://json.schemastore.org/package",
  "name": "@repo/crawl",
  "type": "module",
  "private": true,
  "scripts": {
    "crawl": "bun run src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf -g {dist,coverage,coverage.json,.*cache,*.tsbuildinfo,**.log,**.map}"
  },
  "dependencies": {
    "@repo/data": "workspace:*",
    "@repo/shared": "workspace:*",
    "crawlee": "^3.0.0",
    "cheerio": "*",
    "playwright": "*",
    "puppeteer": "*"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@apify/tsconfig": "^0.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "tsx": "^4.4.0",
    "typescript": "^5.8.3",
    "@types/bun": "^1.2.17",
    "@types/node": "^24.0.10",
    "vitest": "^3.2.4",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
