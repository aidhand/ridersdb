{
  "$schema": "https://json.schemastore.org/package",
  "name": "@repo/site",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run -b nuxt build",
    "start": "nuxt preview",
    "prepare": "nuxt prepare",
    "dev": "nuxt dev --port 4000",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "typecheck": "nuxt typecheck",
    "clean": "rimraf coverage.json tsconfig.tsbuildinfo dist coverage *.d.ts.map"
  },
  "dependencies": {
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "1.13.0",
    "@nuxt/image": "1.10.0",
    "@nuxt/ui": "^3.1.2",
    "@trpc/client": "^11.4.1",
    "@trpc/server": "^11.4.1",
    "@vueuse/core": "^13.3.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.2",
    "magic-regexp": "^0.10.0",
    "nuxt": "^3.17.3",
    "slugify": "^1.6.6",
    "trpc-nuxt": "^1.0.5",
    "vue": "^3.5.14",
    "vue-router": "^4.5.1",
    "zod": "^3.25.49"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@iconify-json/lucide": "^1.2.45",
    "@iconify-json/tabler": "^1.2.18",
    "@nuxt/eslint": "1.4.0",
    "@nuxt/test-utils": "^3.19.0",
    "@playwright/test": "^1.53.2",
    "@repo/data": "workspace:*",
    "@repo/shared": "workspace:*",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/vue": "^8.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.27.0",
    "playwright": "^1.52.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite-plugin-eslint2": "^5.0.3",
    "vitest": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "vue-tsc": "^2.2.10",
    "@types/node": "^24.0.10",
    "@types/bun": "^1.2.17",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
